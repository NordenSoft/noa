node_modules/
dist/
*.log
.DS_Store
.venv/
*.tsbuildinfo
# generated conformance vectors are committed (deterministic); build output is not

# Python
__pycache__/
*.pyc

# Scratch / repro artifacts (audit agents write these to the repo root; never ship them)
_*.mjs
_*.ts
# Added 2026-08-04. The rule above covered two extensions, and the convention it encodes —
# a leading underscore means local scratch — covers all of them. Two scratch files written in
# other languages (_cose-interop-vector.json, _cose_interop_verify.py) were therefore committed
# to a PUBLIC repository while their own headers stated they were gitignored. A convention that
# holds for some extensions is not a convention; it is a coincidence that has not failed yet.
_*.py
_*.json
_*.txt
_*.sh
_repro_*
_probe*
# Exception: a LEGIT shared test fixture that happens to use the _ prefix — deterministic seeded
# Ed25519 keys for byte-identical federation vector regen (test + generator import it; public test
# keys, NEVER real secrets). Without this, the _*.ts scratch rule silently drops it → CI build TS2307.
!test/federation/_seeded-keys.ts
# Per-session agent working dir (evidence/jsonl scratch — never ship)
agent-context/

# Local agent scratch — must never be committed to a PUBLIC repo by a stray `git add -A`.
scratchpad/
.agents/

# The private phone core, when checked out INSIDE this repo (CI does this; developers use a
# sibling). Untracked here so the whole-tree clean-worktree gate measures THIS repo only.
/noa-mobile/

# Browser-automation page snapshots (MCP scratch). Never belongs in the PUBLIC kernel repo.
.playwright-mcp/
